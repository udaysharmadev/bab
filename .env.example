# Set these in cPanel's Node.js App environment settings. Never store secrets here.
NODE_ENV=production
BOAT_SAVE_DB=/home/CPANEL_USER/private/bad-at-boating/voyages.sqlite

# Used by deploy.sh when pulling updates. Keep this in sync with the cPanel Git checkout.
PRODUCTION_BRANCH=main

# cPanel/Passenger supplies PORT automatically. Do not set it manually in cPanel.
