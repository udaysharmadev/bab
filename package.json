{
  "name": "bad-at-boating",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "server": "node --import tsx src/server/index.ts",
    "build": "tsc --noEmit && vite build && node scripts/build-server.mjs",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts tests/*.test.mjs",
    "test:fan": "node --import tsx --test --test-concurrency=1 tests/fan.test.ts tests/fan-network.test.ts",
    "test:fan:browser": "node tests/fan-browser.mjs",
    "test:fan:route": "node tests/fan-route.mjs",
    "tracker": "node scripts/tracker.mjs",
    "tracker:check": "node scripts/tracker.mjs --check",
    "test:accessibility": "node tests/accessibility.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:controls": "node tests/controls.mjs",
    "test:touch": "node tests/touch.mjs",
    "test:reconnect": "node tests/reconnect.mjs",
    "test:animation": "node tests/animation.mjs",
    "test:audio": "node tests/audio.mjs",
    "test:soak": "node --expose-gc --import tsx tests/soak.ts",
    "test:load": "node --expose-gc --import tsx tests/load.ts",
    "test:performance": "node tests/performance.mjs",
    "test:graphics": "node tests/graphics.mjs",
    "test:water": "node tests/water-effects.mjs",
    "test:bends": "node tests/bends-browser.mjs",
    "test:lobby": "node tests/lobby.mjs",
    "test:onboarding": "node tests/onboarding.mjs",
    "test:rescue": "node tests/rescue-browser.mjs",
    "check:deployment": "node scripts/check-deployment.mjs",
    "start": "node app.js",
    "start:production": "node app.js",
    "deploy:cpanel": "bash deploy.sh",
    "test:network": "node --import tsx --test tests/network-stress.test.ts",
    "test:grace": "node --import tsx tests/grace.ts"
  },
  "dependencies": {
    "@colyseus/core": "0.18.19",
    "@colyseus/sdk": "0.18.5",
    "@colyseus/ws-transport": "^0.18.0",
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.185.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "playwright": "^1.62.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "ws": "^8.22.0"
  }
}
